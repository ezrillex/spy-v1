// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CookieLogs {
  id        Int      @id @default(autoincrement())
  name      String
  value     String
  timestamp DateTime @default(now())
}

model RequestLogs {
  id           Int      @id @default(autoincrement())
  roundtrip    Float // in miliseconds
  sent_headers String   @db.Text
  sent_cookies String   @db.Text
  status       Int
  headers      String   @db.Text
  html         String   @db.Text
  error_info   String?  @db.Text
  timestamp    DateTime @default(now())
}
